# Copy this file to ".env" and fill in the values. Never commit the real ".env".
# On the EC2 VM, scripts/aws/bootstrap-ec2.sh creates it for you with random secrets.
#
# TIP: use letters and digits only in passwords (for example `openssl rand -hex 16`).
# Special characters can break the database connection strings.

# Which images to run: ghcr.io/<GITHUB_OWNER>/clicktrail-<service>:<CLICKTRAIL_VERSION>
GITHUB_OWNER=sunilvarmatongali
CLICKTRAIL_VERSION=0.1.0

# Address users see, used to build short links (use the VM's public address on AWS)
PUBLIC_BASE_URL=http://localhost:8080

# Secrets
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-mysql
POSTGRES_PASSWORD=change-me-postgres
# At least 32 characters. Shared by the auth service (signs tokens) and the gateway (verifies them).
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# The first admin account (created by the auth service on start-up)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
